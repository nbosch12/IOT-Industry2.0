<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:f="http://java.sun.com/jsf/core"
          xmlns:af="http://xmlns.oracle.com/adf/faces/rich" xmlns:c="http://java.sun.com/jsp/jstl/core">
  
    <c:set var="viewcontrollerBundle" value="#{adfBundle['view.ViewControllerBundle']}"/>
    <af:panelStretchLayout id="psl1" inlineStyle='background-image:url("../loginBackground.jpg");'
                           styleClass="AFStretchWidth">
        <f:facet name="bottom"/>
        <f:facet name="center">
            <af:panelGroupLayout id="pgl2" inlineStyle='background-image:url("../loginBackground.jpg");'>
                <af:spacer width="9" height="336" id="s2"/>
                <af:panelGroupLayout id="pgl9" layout="vertical">
                    <af:panelGroupLayout id="pgl4" layout="horizontal">
                        <af:spacer width="123" height="10" id="s3"/>
                        <af:panelGroupLayout id="pgl3" layout="vertical"
                                             inlineStyle="width:355px; height:175px; background-color:InfoBackground; border-bottom-left-radius:20px 20px; border-bottom-right-radius:20px 20px; border-radius:20px 20px 20px 20px / 20px 20px 20px 20px ; border-top-left-radius:20px 20px; border-top-right-radius:20px 20px;"
                                             halign="right">
                            <af:spacer width="10" height="20" id="s4"/>
                            <af:panelGroupLayout id="pgl5" layout="horizontal" halign="right">
                                <af:panelGroupLayout id="pgl6" halign="right" valign="middle" layout="vertical">
                                    <af:selectOneRadio label="Select User Type"
                                                       labelStyle="font-weight:bold;font-size:small;"
                                                       contentStyle="font-size:small" id="sor1" layout="horizontal"
                                                       showRequired="true"
                                                       requiredMessageDetail="Please Select User Type" required="true"
                                                       inlineStyle="width:300px"
                                                       binding="#{pageFlowScope.LoginBean.utype}">
                                        <af:selectItem label="Administrator" value="Administrator" id="si1"/>
                                        <af:selectItem label="User" value="User" id="si2"/>
                                    </af:selectOneRadio>
                                    <af:spacer width="10" height="10" id="s9"/>
                                    <af:inputText label="User Name" id="it2"
                                                  labelStyle="font-weight:bold;font-size:small;" showRequired="true"
                                                  requiredMessageDetail="Please enter UserName" required="true"
                                                  contentStyle="font-size:small;width:200px" inlineStyle="width:300px"
                                                  binding="#{pageFlowScope.LoginBean.uname}"/>
                                    <af:spacer width="10" height="10" id="s1"/>
                                    <af:inputText label="Password" id="it1" secret="true"
                                                  labelStyle="font-weight:bold;font-size:small" required="true"
                                                  requiredMessageDetail="Please enter Password" showRequired="true"
                                                  contentStyle="font-size:small;width:200px" inlineStyle="width:296px"
                                                  binding="#{pageFlowScope.LoginBean.pwd}"/>
                                    <af:spacer width="10" height="10" id="s5"/>
                                    <af:commandButton id="b1" text="Login"
                                                      inlineStyle="font-weight:bold; font-size:small; border-bottom-left-radius:5px 5px; border-bottom-right-radius:5px 5px; border-radius:5px 5px;"
                                                      action="gotoDoLogin" icon="#{resource['images:loginBtnIcn.png']}">
                                        <af:setPropertyListener type="action" from="login"
                                                                to="#{pageFlowScope.LoginBean.decision}"/>
                                    </af:commandButton>
                                </af:panelGroupLayout>
                                <af:spacer width="33" height="20" id="s6"/>
                            </af:panelGroupLayout>
                        </af:panelGroupLayout>
                    </af:panelGroupLayout>
                </af:panelGroupLayout>
                <af:popup childCreation="deferred" autoCancel="disabled" id="p1"
                          binding="#{pageFlowScope.LoginBean.loginPopupBinding}">
                    <af:dialog id="d1" type="none" inlineStyle="height:80px; width:210px; font-size:small; color:Red; "
                               title="Error" titleIconSource="#{resource['images:redWarning.png']}">
                        <af:outputFormatted id="aot1" value="#{viewcontrollerBundle.WRONG_USERNAME_OR_PASSWORD}"
                                            inlineStyle="color:Black;"/>
                    </af:dialog>
                </af:popup>
            </af:panelGroupLayout>
        </f:facet>
        <f:facet name="start"/>
        <f:facet name="end"/>
        <f:facet name="top"/>
    </af:panelStretchLayout>
</jsp:root>
