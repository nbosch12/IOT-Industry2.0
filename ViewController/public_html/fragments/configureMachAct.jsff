                                                                                              autoCancel="disabled"
                                                                                              id="p1"
                                                                                              binding="#{pageFlowScope.MachineActionBean.rfIdPopupBinding}">
                                                                                        <af:dialog id="d1" type="none"
                                                                                                   inlineStyle="height:60px; width:170px;"
                                                                                                   title="Error"
                                                                                                   titleIconSource="#{resource['images:redWarning.png']}">
                                                                                            <af:outputText value="#{viewcontrollerBundle.PLEASE_ENTER_RFID}"
                                                                                                           id="ot2"/>
                                                                                        </af:dialog>
                                                                                    </af:popup>
                                                                                    <af:spacer width="450" height="10"
                                                                                               id="s1"/>
