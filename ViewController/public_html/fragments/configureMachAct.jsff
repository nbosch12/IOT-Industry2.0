                                                                                                 halign="center"
                                                                                                 inlineStyle="width:1228px; height:386px;">
                                                                                <af:panelGroupLayout id="pgl4"
                                                                                                     layout="horizontal">
                                                                                    <af:inputText value="#{bindings.MaterialId1.inputValue}"
                                                                                                  label="#{viewcontrollerBundle.ENTER_MATERIAL_NAME}"
                                                                                                  required="#{bindings.MaterialId1.hints.mandatory}"
                                                                                                  columns="#{bindings.MaterialId1.hints.displayWidth}"
                                                                                                  maximumLength="#{bindings.MaterialId1.hints.precision}"
                                                                                                  shortDesc="#{bindings.MaterialId1.hints.tooltip}"
                                                                                                  id="it17"
