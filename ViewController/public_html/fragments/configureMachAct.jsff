<?xml version='1.0' encoding='UTF-8'?>
<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.1" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
          xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
          xmlns:h="http://java.sun.com/jsf/html">
    <c:set var="viewcontrollerBundle" value="#{adfBundle['view.viewcontrollerBundle']}"/>
    <af:panelStretchLayout id="psl1" dimensionsFrom="parent">
        <f:facet name="center">
            <af:resource type="javascript">
              function methodDescription(event) {
                  var outputText = event.getSource();
                  AdfCustomEvent.queue(outputText, "MethodDescriptionEvent");
                  event.cancel();
              }

              function displayMethodNames(event) {
                  var commandButton = event.getSource();
                  AdfCustomEvent.queue(commandButton, "DisplayMethodNamesEvent");
                  event.cancel();
              }

              function deleteFunction(event) {
                  var link = event.getSource();
                  AdfCustomEvent.queue(link, "ServerEventToGetValue");
                  event.cancel();
              }
            </af:resource>
            <af:panelGridLayout id="pgl1" inlineStyle="background-color:InactiveBorder;" dimensionsFrom="parent">
                <af:gridRow marginTop="5px" height="60px" id="gr1">
                    <af:gridCell marginStart="5px" width="210px" id="gc1">
                        <af:image source="#{resource['images:bosch_logo.png']}" shortDesc="boschLogo"
                                  inlineStyle="height:48px;width:160px;" id="i1"/>
                    </af:gridCell>
                    <af:gridCell marginStart="5px" width="100%" id="gc2" halign="center" valign="middle"></af:gridCell>
                    <af:gridCell marginStart="5px" width="380px" marginEnd="5px" id="gc4" halign="end" valign="middle">
                        <af:panelGroupLayout id="pgl2" layout="horizontal">
                            <af:menuBar id="mb1">
                                <af:commandMenuItem text="#{viewcontrollerBundle.GotoUserPage}" id="cmi3"
                                                    inlineStyle="font-size:small;" action="gotoUserBTF"/>
                                <af:image source="#{resource['images:verticalLine.png']}" shortDesc="verticalLine"
                                          id="i7" inlineStyle="height:12px;"/>
                                <af:commandMenuItem text="#{viewcontrollerBundle.ConfigureMachine}" id="cmi2"
                                                    inlineStyle="font-size:small;" action="configureMachines"/>
                                <af:image source="#{resource['images:verticalLine.png']}" shortDesc="verticalLine"
                                          id="i5" inlineStyle="height:12px;"/>
                            </af:menuBar>
                            <af:outputText value="#{viewcontrollerBundle.Welcome}" id="ot1"
                                           inlineStyle="font-size:small;"/>
                            <af:image source="#{resource['images:userLogin.png']}" shortDesc="userLogin" id="i3"/>
                            <af:activeOutputText id="aot1" inlineStyle="font-size:small;"
                                                 value="#{sessionScope.uname}"/>
                            <af:spacer width="13" height="10" id="s4"/>
                            <af:link text="#{viewcontrollerBundle.English}"
                                     rendered="#{facesContext.viewRoot.locale.language eq 'de'}" id="l2"
                                     inlineStyle="font-size:small;"
                                     actionListener="#{pageFlowScope.MachineActionBean.englishLanguage}"/>
                            <af:link text="#{viewcontrollerBundle.Deutsch}"
                                     rendered="#{facesContext.viewRoot.locale.language eq 'en'}" id="l1"
                                     inlineStyle="font-size:small;"
                                     actionListener="#{pageFlowScope.MachineActionBean.deutschLanguage}"/>
                            <af:spacer width="13" height="10" id="s5"/>
                            <af:link text="#{viewcontrollerBundle.Help}" id="l3" inlineStyle="font-size:small;"/>
                            <af:spacer width="13" height="10" id="s6"/>
                            <af:link text="#{viewcontrollerBundle.Logout}" id="l4" inlineStyle="font-size:small;"
                                     action="back"/>
                            <af:spacer width="13" height="10" id="s7"/>
                        </af:panelGroupLayout>
                    </af:gridCell>
                </af:gridRow>
                <af:gridRow marginTop="5px" height="100%" marginBottom="5px" id="gr2">
                    <af:gridCell marginStart="5px" width="100%" id="gc6" columnSpan="3" halign="stretch"
                                 valign="stretch">
                        <af:decorativeBox id="db1" theme="contentBody">
                            <f:facet name="center">
                                <af:panelGridLayout id="pgl3">
                                    <af:gridRow marginTop="5px" height="100%" marginBottom="5px" id="gr4">
                                        <af:gridCell marginStart="5px" width="100%" id="gc3" halign="stretch"
